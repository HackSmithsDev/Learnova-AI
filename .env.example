# Environment Variables: (.env)
# --- Flask Server Port ---
FLASK_HOST=your_flask_host_here
FLASK_RUN_PORT=your_flask_port_here

# --- Application Security ---
SECRET_KEY=your_secret_key_here

# --- PostgreSQL Connection ---
# Set this if your local PostgreSQL setup is different from the default in config.py
DATABASE_URL=postgresql://<your_username>:<your_password>@my_host:5432/<your_db_name_here>

# --- Redis Cache (M1) ---
REDIS_URL=redis://localhost:6379/0

# --- Gemini API (M3) ---
# CRITICAL: Replace with your actual Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

OPEN_AI_API_KEY=YOUR_OPENAI_API_KEY

# --- GROQ API Key ---
GROQ_API_KEY=your_groq_api_key_here

GROQ_MODEL=your_groq_model_here

# --- Flask-Mail Configuration for Titan Mail (SMTP_SSL) ---
MAIL_SERVER='smtp.titan.email'
MAIL_PORT=465
MAIL_USERNAME='your_titan_mail_username_here'
MAIL_PASSWORD='your_titan_mail_password_here'
MAIL_FROM='noreply@hacksmiths.dev'
MAIL_FROM_NAME='Learnova AI'
MAIL_ADMIN_ADDRESS='your_email_here'